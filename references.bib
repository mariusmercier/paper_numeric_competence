@article{Sumner-2007,
  title = {Human {{Medial Frontal Cortex Mediates Unconscious Inhibition}} of {{Voluntary Action}}},
  author = {Sumner, Petroc and Nachev, Parashkev and Morris, Peter and Peters, Andrew M. and Jackson, Stephen R. and Kennard, Christopher and Husain, Masud},
  year = 2007,
