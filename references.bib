@misc{Mercier-2025c,
  title = {Who Knows What? {{Bayesian Competence Inference}} Guides {{Knowledge Attribution}} and {{Information}} Search},
  shorttitle = {Who Knows What?},
  author = {Mercier, Marius and Morin, Olivier and Mercier, Hugo and Quillien, Tadeg},
  year = 2025,
