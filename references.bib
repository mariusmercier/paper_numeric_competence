@article{Hunt-2008,
  title = {Introduced {{{\emph{Lantana}}}}{\emph{ Camara}} Used as Tools by {{New Caledonian}} Crows ( {{{\emph{Corvus}}}}{\emph{ Moneduloides}} )},
  author = {Hunt, G. R.},
  year = 2008,
