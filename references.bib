@techreport{Acerbi-2023,
  type = {Preprint},
  title = {Weak Content Preferences Stabilise Culture},
  author = {Acerbi, Alberto},
  year = 2023,
  month = mar,
  institution = {Open Science Framework},
  doi = {10.31219/osf.io/7z4ws},
  urldate = {2023-09-12},
  abstract = {One of the goals of cultural evolution research is to understand what makes some cultural traits successful and others not. An intuitive distinction, reflected in research, considers forces related to social influence (such as copying from the majority, or from certain individuals) and related to intrinsic features of cultural traits (such as being more effective, easy to transmit, or memorable). Here I show, using individual-based models, that preferences for content, being stable and directional, determine the equilibrium point of cultural dynamics, when acting together with non-directional social influence. The results have implications regarding the importance of keeping into account individual-level, non-social, factors, when studying cultural evolution, as well as the interpretation of cross-cultural regularities, that have to be expected, but can be product of weak directional forces, intensified by social influence.},
  langid = {english},
  file = {/Users/mariusmercier/Zotero/storage/JAPIC4IW/Acerbi-2023.pdf}
}

@misc{Acerbi-2023a,
