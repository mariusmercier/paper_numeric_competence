@misc{Tiberj-2020,
  title = {Dynamiques de Mobilisation : Comprendre La Formation Des Choix \'Electoraux - Vague 1 ({{ELIPSS}} 2013)},
  shorttitle = {Dynamiques de Mobilisation},
  author = {Tiberj, Vincent and Gougou, Florent and Sciences Po, Centre De Donn{\'e}es Socio-Politiques (CDSP)},
  year = 2020,
  publisher = {data.sciencespo},
  doi = {10.21410/7E4/WCJ1QW},
  urldate = {2022-10-18},
  abstract = {La majeure partie des connaissances produites en sociologie politique quantitative provient des enqu\^etes conduites au moment des \'elections. L'\'etude longitudinale DYNAMOB est propos\'ee par Florent Gougou, Vincent Tiberj et vingt-cinq politistes fran\c cais. Elle se distingue des enqu\^etes classiques en couvrant aussi bien les p\'eriodes \'electorales que les p\'eriodes ordinaires. Ce dispositif vise \`a mesurer le poids relatif des facteurs de court terme (effet des campagnes \'electorales, notamment) et des facteurs de long terme sur le vote des \'electeurs. La premi\`ere vague de DYNAMOB s'est d\'eroul\'ee en septembre-octobre 2013. Elle avait essentiellement trois objectifs : - Caract\'eriser le rapport des pan\'elistes au politique en mesurant le sentiment de comp\'etence objective et subjective, les repr\'esentations du politique, la conception du r\^ole de citoyen, les pr\'ef\'erences politiques, les registres de participation ; - Mesurer les syst\`emes de valeurs des pan\'elistes en les interrogeant sur la globalisation, la construction europ\'eenne, l'environnement etc. ; - Comprendre l'entr\'ee en relation des pan\'elistes avec la politique par les r\'eseaux interpersonnels ou les pratiques m\'ediatiques. The majority of the knowledge produced in quantitative political sociology comes from the surveys conducted during elections. The DYNAMOB longitudinal survey was conducted by Florent Gougou, Vincent Tiberj and 25 French political scientists. It differs from conventional surveys in that it covers both electoral and non-electoral periods. The purpose of this survey is to measure the relative influence of short-term factors (in particular, the effects of electoral campaigns) and of long-term factors on voting decisions. The first wave of DYNAMOB took place in September-October 2013. It essentially had three objectives: To characterise the panellists' attitude to politics by measuring their sense of objective and subjective competence, their representations of politics, their conception of the role of the citizen, political preferences, levels of participation; To map the panellists' value systems by asking them about globalisation, the construction of Europe, the environment, etc.; To understand how the panellists come into contact with politics through interpersonal networks or through the media.},
  collaborator = {CNRS, Centre De Donn{\'e}es Socio-Politiques (CDSP), Sciences Po and CNRS, Centre De Donn{\'e}es Socio-Politiques (CDSP), Sciences Po and Institut National D'{\'e}tudes D{\'e}mographiques, Service Des Enqu{\^e}tes Et Des Sondages}
}

