@article{Young-,
  title = {Systemic and {{Individual-Level Predictors}} of `{{Correct}}' and {{Policy-Aligned}}},
  author = {Young, David J},
  pages = {141},
  abstract = {Scholars have long worried about how well citizens' electoral voting choices reflect their preferences, and whether individual and institutional factors influence the quality of voting choices. One key debate is whether, and to what extent, citizens' use of political heuristics can compensate for their typically-low levels of political knowledge. Simultaneously, there has been debate as to how the quality of citizens' voting choices should best be measured. In this paper, I critically review the literature on the individual and institutional factors of preference-aligned voting, and present two new studies which analyse large datasets using novel methodologies to inform these debates, each using a different standard of vote choice quality. In the first study, I adopt the standard of the `correct vote' popularised by Lau, Patel, Fahmy, and Kaufman (2014). I adapt the measure to resolve a previously-identified limitation, and use this to explore individual and institutional-level predictors of voting choice across 143 head-of-state elections conducted in 48 global democracies from 1996-2018. In the second study, I adopt the standard of a `policy preference aligned' vote, and apply this to study vote choice quality in British (2015, 2017, 2019), Dutch (2012) and Swedish (2014) general elections. Here, I identify clusters of voters in the policy space using machine learning and explore differences in their levels of policy alignment to better understand whether and why some citizens make better-aligned vote choices than others. Across both studies, I test for the effects of heuristics, institutional factors like the proportionality of the electoral system, and individuallevel factors like personality on vote choice quality.},
  langid = {english},
  file = {/Users/mariusmercier/Zotero/storage/ZMCP4NJF/Young-.pdf}
}

