@article{Safra-2020,
  title = {Tracking Historical Changes in Perceived Trustworthiness in {{Western Europe}} Using Machine Learning Analyses of Facial Cues in Paintings},
  author = {Safra, Lou and Chevallier, Coralie and Gr{\`e}zes, Julie and Baumard, Nicolas},
  year = 2020,
