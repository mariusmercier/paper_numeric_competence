@article{Claidiere-2017,
  title = {Argumentation and the Diffusion of Counter-Intuitive Beliefs},
  author = {Claidi{\`e}re, Nicolas and Trouche, Emmanuel and Mercier, Hugo},
  year = 2017,
  journal = {Journal of Experimental Psychology: General},
  volume = {146},
  number = {7},
  pages = {1052--1066},
  publisher = {American Psychological Association},
  address = {US},
  issn = {1939-2222},
  doi = {10.1037/xge0000323},
  abstract = {Research in cultural evolution has focused on the spread of intuitive or minimally counterintuitive beliefs. However, some very counterintuitive beliefs can also spread successfully, at least in some communities---scientific theories being the most prominent example. We suggest that argumentation could be an important factor in the spread of some very counterintuitive beliefs. A first experiment demonstrates that argumentation enables the spread of the counterintuitive answer to a reasoning problem in large discussion groups, whereas this spread is limited or absent when participants can show their answers to each other but cannot discuss. A series of experiments using the technique of repeated transmission show that, in the case of the counterintuitive belief studied: (a) arguments can help spread this belief without loss; (b) conformist bias does not help spread this belief; and (c) authority or prestige bias play a minimal role in helping spread this belief. Thus, argumentation seems to be necessary and sufficient for the spread of some counterintuitive beliefs. (PsycInfo Database Record (c) 2020 APA, all rights reserved)},
  keywords = {Arguments,Attitudes,Evolutionary Psychology,Intuition,Sociocultural Factors}
}

