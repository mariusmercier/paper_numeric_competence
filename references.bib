  publisher = {Simon \& Schuster},
  address = {London},
  abstract = {By the author of the acclaimed bestsellers Benjamin Franklin and Steve Jobs, this is the definitive biography of Albert Einstein.How did his mind work? What made him a genius? Isaacson's biography shows how his scientific imagination sprang from the rebellious nature of his personality. His fascinating story is a testament to the connection between creativity and freedom.  Based on newly released personal letters of Einstein, this book explores how an imaginative, impertinent patent clerk---a struggling father in a difficult marriage who couldn't get a teaching job or a doctorate---became the mind reader of the creator of the cosmos, the locksmith of the mysteries of the atom, and the universe. His success came from questioning conventional wisdom and marveling at mysteries that struck others as mundane. This led him to embrace a morality and politics based on respect for free minds, free spirits, and free individuals.  These traits are just as vital for this new century of globalization, in which our success will depend on our creativity, as they were for the beginning of the last century, when Einstein helped usher in the modern age.},
  isbn = {978-0-7432-6474-7},
  langid = {english}
}

