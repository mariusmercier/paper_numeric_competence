@incollection{Wojtowicz-2022,
  title = {The {{Motivational Processes}} of {{Sense-Making}}},
  booktitle = {The {{Drive}} for {{Knowledge}}: {{The Science}} of {{Human Information Seeking}}},
  author = {Wojtowicz, Zachary and Chater, Nicholas and Loewenstein, George},
  year = 2022,
  pages = {30},
  abstract = {In this chapter we discuss the psychological function of the ``drive for sense-making'': our innate desire to make sense of the world. We start by discussing why sense-making generates a drive, similar to the drives associated with the primary reinforcers of food, water, sleep, sex, shelter, and air. The essence of our argument is that the drive for sensemaking helps us balance the immediate benefits of satisfying tangible wants against the delayed benefits of investing in our knowledge and understanding in a computationally efficient manner. We then examine three different considerations that shape the particular form sensemaking takes: (1) the practical utility of accurate beliefs for attaining concrete goals, (2) the motivational significance of some beliefs, which generates a desire to make sense of the world in a way that feels good, and (3) the impact of computational limitations on the sense-making process, including our limited ability to explicitly predict what information will turn out to be useful. Finally, we turn our attention to how these features of sense-making help to explain phenomena that have become increasingly prominent in recent years, such as the precipitous growth of conspiracy theories, science denial, and political polarization.},
  langid = {english}
}

