  abstract = {Examined the impact of outcome biases on dispositional correspondent inferences made about members of a small group performing a problem solving task. In Exp 1, with 238 undergraduates, inferences about a stable uncontrollable trait (intelligence) and a malleable trait (motivation) were biased by the outcome of performance. Different inferences were made about the same performance at different times if it resulted in different outcomes. In Exp 2, with 129 university students, the group's outcomes changed either because their performance changed or because the decision rules governing outcomes changed. The impact of outcome biases on inferences about the group's intelligence was as substantial when outcomes varied because of decision rule changes (when behavior remained invariant) as when outcomes changed because of a change in the group's performance. (PsycInfo Database Record (c) 2022 APA, all rights reserved)},
  keywords = {Group Performance,Group Problem Solving,Inference,Intelligence,Motivation}
}

@article{Magid-2018,
