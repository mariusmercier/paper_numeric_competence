@article{Glowacki-2024,
  title = {The Evolution of Peace},
  author = {Glowacki, Luke},
  year = 2024,
  month = jan,
  journal = {Behavioral and Brain Sciences},
  volume = {47},
  pages = {e1},
  issn = {0140-525X, 1469-1825},
  doi = {10.1017/S0140525X22002862},
  urldate = {2024-06-07},
  abstract = {While some species have affiliative and even cooperative interactions between individuals of different social groups, humans are alone in having durable, positive-sum, interdependent relationships across unrelated social groups. Our capacity to have harmonious relationships that cross group boundaries is an important aspect of our species' success, allowing for the exchange of ideas, materials, and ultimately enabling cumulative cultural evolution. Knowledge about the conditions required for peaceful intergroup relationships is critical for understanding the success of our species and building a more peaceful world. How do humans create harmonious relationships across group boundaries and when did this capacity emerge in the human lineage? Answering these questions involves considering the costs and benefits of intergroup cooperation and aggression, for oneself, one's group, and one's neighbor. Taking a game theoretical perspective provides new insights into the difficulties of removing the threat of war and reveals an ironic logic to peace -- the factors that enable peace also facilitate the increased scale and destructiveness of conflict. In what follows, I explore the conditions required for peace, why they are so difficult to achieve, and when we expect peace to have emerged in the human lineage. I argue that intergroup cooperation was an important component of human relationships and a selective force in our species history beginning at least 300 thousand years. But the preconditions for peace only emerged in the past 100 thousand years and likely coexisted with intermittent intergroup violence which would have also been an important and selective force in our species' history.},
  langid = {english},
  keywords = {cooperation,human evolution,hunter-gatherers,intergroup relationships,peace,war}
}

@book{Godefroid-2011,
  title = {{Psychologie}},
  author = {Godefroid, Jo},
  year = 2011,
  publisher = {De Boeck},
  address = {Bruxelles},
  abstract = {Destin\'e principalement aux \'etudiants, ainsi qu'au lecteur profane en qu\^ete d'informations et de synth\`eses approfondies, ce manuel est sans doute le seul ouvrage francophone (et peut-\^etre europ\'een) \`a proposer un panorama aussi exhaustif des connaissances accumul\'ees depuis cent trente ans par les divers secteurs de la psychologie occidentale, et les multiples courants qui ont travers\'e leur histoire.  Comme son auteur, il se situe au confluent des conceptions europ\'eennes et nord-am\'ericaines de la psychologie et de son enseignement. Et m\^eme s'il s'apparente, dans sa facture, aux manuels anglosaxons, il s'en distingue toutefois par le fait qu'en plus de pr\'esenter une suite de donn\'ees de fa\c con simplifi\'ee, il cherche \`a cr\'eer des liens entre celles-ci et entre les diff\'erents chapitres, permettant ainsi un cheminement logique \`a travers la mati\`ere.  L'auteur a \'egalement cherch\'e \`a rendre le contenu le plus attrayant possible en l'agr\'ementant de nombreuses illustrations, ainsi que d'encadr\'es et de dossiers qui visent \`a \'eclairer certaines notions, mais \'egalement \`a soulever de nouvelles interrogations permettant d'aiguiser le sens critique du lecteur. Un glossaire, une bibliographie et un index des notions des plus complets lui sont par ailleurs propos\'es, afin qu'\`a tout instant, il soit en mesure d'obtenir l'information n\'ecessaire pour la compr\'ehension et l'approfondissement des multiples donn\'ees pr\'esentes dans ce manuel.  Jo Godefroid est Docteur en Psychologie. Sa carri\`ere t\'emoigne d'une diversit\'e d'int\'er\^ets et d'exp\'eriences. Apr\`es une mission p\'edagogique de plusieurs ann\'ees en Afrique centrale, visant \`a la mise au point de techniques d'alphab\'etisation, il a poursuivi, \`a l'universit\'e de Li\`ege, une formation en psychologie au cours de laquelle il fut \'egalement attir\'e par la Psychologie du langage, la Psychologie exp\'erimentale et l'\'Ethologie. \`A partir de 1969, il a, durant une trentaine d'ann\'ees, dispens\'e ses cours dans l'enseignement sup\'erieur, \`a la fois dans un Coll\`ege d'enseignement g\'en\'eral et professionnel (CEGEP) et \`a l'universit\'e du Qu\'ebec. \`A c\^ot\'e d'un enseignement diversifi\'e des connaissances de base de la Psychologie, il a \'egalement anim\'e des s\'eminaires et des recherches portant sur le comportement animal, les m\'ecanismes de perception, le comportement sexuel, le vieillissement et l'approche du mourant.},
  isbn = {978-2-8041-6391-4},
  langid = {french}
}

