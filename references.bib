@misc{Esmaily-2024,
  title = {Raising {{Social Stakes Raises Confidence}}},
  author = {Esmaily, Jamal and Abharzad, Elham and Knogler, Simon and Deroy, Ophelia and Bahrami, Bahador},
  year = 2024,
  publisher = {SSRN},
  doi = {10.2139/ssrn.4844364},
  urldate = {2026-03-06},
  abstract = {In many decisions, there is more at stake than our own benefit : typically, when we work, we need to make accurate decisions, not just for personal profit, but also because it affects the public or clients. Here, we examined whether these social stakes that accompany our decisions affect the confidence in perceptual decisions. In Experiment 1, we used a within-subjects design (N=28 healthy adults) to compare the impact of high and low social stakes on choice, reaction and confidence in motion perception. Results showed that higher stakes came with increased confidence and longer reaction times. In Experiment 2, we utilized a pre-test plus treatment online design (N=147) using luminance perception. The results replicated the increase in confidence observed for higher stakes in Experiment 1. In Experiment 3, (N=114, online) we explored whether the effects of social stakes were specific to confidence reports by allowing participants to opt out of decisions when uncertain. Here, social stakes did not influence the opt-out rate. Overall, our findings support the hypothesis that varying social stakes do not alter our uncertainty about the state of the world or decision accuracy but rather enhance our sense of self-efficacy and expressed confidence. Thus, confidence reporting is not a monolithic construct but comprises multiple elements, including subjective uncertainty and aspects of self-image and self-esteem.},
  archiveprefix = {SSRN},
  langid = {english},
  file = {/Users/mariusmercier/Zotero/storage/J3234BH8/Esmaily-2024.pdf}
}

