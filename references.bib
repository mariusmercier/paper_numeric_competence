  shorttitle = {Clinical Effectiveness of Very-Low-Energy Diets in the Management of Weight Loss},
  author = {Parretti, H. M. and Jebb, S. A. and Johns, D. J. and Lewis, A. L. and {Christian-Brown}, A. M. and Aveyard, P.},
  year = 2016,
  journal = {Obesity Reviews},
