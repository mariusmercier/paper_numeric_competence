@article{Eriksson-2014,
  title = {Corpses, {{Maggots}}, {{Poodles}} and {{Rats}}: {{Emotional Selection Operating}} in {{Three Phases}} of {{Cultural Transmission}} of {{Urban Legends}}},
  shorttitle = {Corpses, {{Maggots}}, {{Poodles}} and {{Rats}}},
  author = {Eriksson, Kimmo and Coultas, Julie C.},
  year = 2014,
  month = jan,
  journal = {Journal of Cognition and Culture},
  volume = {14},
  number = {1-2},
  pages = {1--26},
  issn = {1567-7095, 1568-5373},
  doi = {10.1163/15685373-12342107},
  urldate = {2022-05-22},
  abstract = {In one conception of cultural evolution, the evolutionary success of cultural units that are transmitted from individual to individual is determined by forces of cultural selection. Here we argue that it is helpful to distinguish between several distinct phases of the transmission process in which cultural selection can operate, such as a choose-toreceive phase, an encode-and-retrieve phase, and a choose-to-transmit phase. Here we focus on emotional selection in cultural transmission of urban legends, which has previously been shown to operate in the choose-to-transmit phase. In a series of experiments we studied serial transmission of stories based on urban legends manipulated to be either high or low on disgusting content. Results supported emotional selection operating in all three phases of cultural transmission. Thus, the prevalence of disgusting urban legends in North America may be explained by emotional selection through a multitude of pathways.},
  langid = {english},
  file = {/Users/mariusmercier/Zotero/storage/TUBVMH5N/Eriksson-2014.pdf}
}

