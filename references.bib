@mastersthesis{Klopfenstein-2022,
  title = {Explaining the Cultural Success of Explanations},
  author = {Klopfenstein, Aurelien and Mercier, Hugo},
  year = 2022,
  abstract = {Explanations are widely successful cultural products, which satisfy a drive for sensemaking when consumed. It is argued that understanding their success requires to take into account not only their philosophically normative features, but also their distinct phenomenology, and in particular the surprisingness that they can evoke. In three experiments (N = 800), participants rate explanations from various sources, including from the popular Reddit forum Explain Like I'm Five. The appeal of an explanation is measured by the interest in it, its perceived cleverness and the willingness to share it with others. Three factors are identified as predictive of appeal: normative quality or explanatoriness, surprisingness and usefulness. The effect of surprisingness is discovered to remain stable when controlling for prior knowledge. These results challenge the widespread assumption that the main function of an explanation is to foster individual learning. They contribute to broadening the psychology of explanations, and bear implications for theories of creativity and cultural evolution.},
  langid = {english},
  file = {/Users/mariusmercier/Zotero/storage/2246Q649/Klopfenstein et Nicod - Explaining the cultural success of explanations.pdf}
}

