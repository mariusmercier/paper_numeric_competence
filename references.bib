@incollection{Mahr-2022,
  title = {A {{Short History}} of {{Theories}} of {{Intuitive Theories}}},
  booktitle = {A {{Life}} in {{Cognition}}: {{Studies}} in {{Cognitive Science}} in {{Honor}} of {{Csaba Pl\'eh}}},
  author = {Mahr, Johannes B. and Csibra, Gergely},
