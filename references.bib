  author = {De Courson, Beno{\^i}t and Fitouchi, L{\'e}o and Bouchaud, Jean-Philippe and Benzaquen, Michael},
  year = 2021,
  month = aug,
  journal = {Scientific Reports},
  volume = {11},
  number = {1},
  pages = {16566},
  issn = {2045-2322},
  doi = {10.1038/s41598-021-95914-7},
  urldate = {2023-12-02},
  abstract = {Abstract                            The ability to learn from others (social learning) is often deemed a cause of human species success. But if social learning is indeed more efficient (whether less costly or more accurate) than individual learning, it raises the question of why would anyone engage in individual information seeking, which is a necessary condition for social learning's efficacy. We propose an evolutionary model solving this paradox, provided agents (i) aim not only at information quality but also vie for audience and prestige, and (ii) do not only value accuracy but also reward originality---allowing them to alleviate herding effects. We find that under some conditions (large enough success rate of informed agents and intermediate taste for popularity), both social learning's higher accuracy and the taste for original opinions are evolutionarily-stable, within a mutually beneficial               division of labour               -like equilibrium. When such conditions are not met, the system most often converges towards mutually detrimental equilibria.},
  langid = {english},
  file = {/Users/mariusmercier/Zotero/storage/TPQJVNQE/DeCourson-2021.pdf}
}

