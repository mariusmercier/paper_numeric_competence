ge at 20s elapsed + 5s remaining\n    \/\/  - 20s (fast): only 5s remaining\n    \/\/ =====================================================\n\n    \/\/ Mid-point warning only for 40s condition \n    var msgDiv1 = null;\n    var midWarningTimeMs = null;\n\n    if (timeLimitSec === 40) {\n        midWarningTimeMs = 20000; \/\/ 20 seconds elapsed (20 seconds left)\n        msgDiv1 = createMessage(\n            msg1Id,\n            \"20 seconds to go\",\n            \"#eaeaea\",\n            \"#333\"\n        );\n    }\n\n    \/\/ 5-second warning: always used\n    var msgDiv2 = createMessage(\n        msg2Id,\n        \"5 seconds to go, please submit your answer\",\n        \"#eaeaea\",\n        \"#333\"\n    );\n\n\n    \/\/ ---- Mid warning (only 40s condition) ----   \n    if (msgDiv1 && midWarningTimeMs !== null) {\n        window[globalTimerKey].push(setTimeout(function () {\n            msgDiv1.style.display = \"block\";\n            setTimeout(function () { msgDiv1.style.display = \"none\"; }, 2000);\n        }, midWarningTimeMs));\n    }\n\n    \/\/ ---- 5-second warning (both conditions) ----\n    window[globalTimerKey].push(setTimeout(function () {\n        msgDiv2.style.display = \"block\";\n        setTimeout(function () { msgDiv2.style.display = \"none\"; }, 2000);\n    }, message2Time));\n\n    \/\/ ---- Auto-submit at timeout ----\n    window[globalTimerKey].push(setTimeout(function () {\n        if (!hasRecorded) {\n            hasRecorded = true;\n\n            \/\/ Record full time limit if auto-submitted\n            Qualtrics.SurveyEngine.setEmbeddedData(\n                \"TimeOnQuestion\" + questionID,\n                timeLimitSec.toFixed(2)\n            );\n\n            \/\/ If no answer, force a value (adapt selector to your question type)\n            var inputField = jQuery(\"input[type='text']\").first();\n            inputField.val(\"0\");\n            inputField.trigger(\"input\");\n            inputField.blur();\n\n            setTimeout(function () {\n                const nextButton = document.getElementById(\"NextButton\");\n                if (nextButton) nextButton.click();\n            }, 300);\n        }\n    }, totalTime));\n\n    \/\/ ---- Manual submit ----\n    jQuery(\"#NextButton\").on(\"click\", function (event) {\n        if (!hasRecorded) {\n            event.preventDefault();\n            recordClickTime();\n        }\n    });\n\n    function recordClickTime() {\n        if (hasRecorded) return;\n        hasRecorded = true;\n\n        var endTime = new Date();\n        var elapsed = (endTime - startTime) \/ 1000;\n        Qualtrics.SurveyEngine.setEmbeddedData(\n            \"TimeOnQuestion\" + questionID,\n            elapsed.toFixed(2)\n        );\n\n        \/\/ Clear the timers once the participant has answered\n        window[globalTimerKey].forEach(clearTimeout);\n        window[globalTimerKey] = [];\n\n\n        setTimeout(function () {\n            confirmDiv.style.display = \"none\";\n            Qualtrics.SurveyEngine.clickNextButton();\n        }, 500);  \n    }\n});\n\n\n\/\/ ========================================================\n\/\/            DISABLE COPY \/ PASTE \/ SELECTION  \n\/\/ ========================================================\n\nQualtrics.SurveyEngine.addOnload(function() {\n    document.body.style.userSelect = \"none\";\n    document.body.style.webkitUserSelect = \"none\";\n    document.body.style.msUserSelect = \"none\";\n    document.body.style.mozUserSelect = \"none\";\n\n    document.addEventListener(\"contextmenu\", function(e) { e.preventDefault(); });\n    document.addEventListener(\"copy\",        function(e) { e.preventDefault(); });\n    document.addEventListener(\"paste\",       function(e) { e.preventDefault(); });\n    document.addEventListener(\"cut\",         function(e) { e.preventDefault(); });\n    document.addEventListener(\"dragstart\",   function(e) { e.preventDefault(); });\n});","DefaultChoices":false,"QuestionType":"TE","Sel