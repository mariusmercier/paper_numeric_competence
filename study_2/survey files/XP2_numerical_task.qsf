FIGURE THESE TWO LINES PER QUESTION *****\/\n    var questionID = 2.5;   \/\/ question ID\n    var quizNumber = 2;     \/\/ 2 for Quiz 2 questions, 3 for Quiz 3 questions\n    \/***************************************************\/\n\n    \/\/ ---- Get time limit from Embedded Data ----\n    \/\/ Set Quiz2Limit \/ Quiz3Limit to 20 (fast) or 40 (slow)\n    var rawLimit;\n    if (quizNumber === 2) {\n        rawLimit = Qualtrics.SurveyEngine.getEmbeddedData(\"Quiz2Limit\");\n    } else if (quizNumber === 3) {\n        rawLimit = Qualtrics.SurveyEngine.getEmbeddedData(\"Quiz3Limit\");\n    } else {\n        rawLimit = \"20\"; \n    }\n\n    var timeLimitSec = parseInt(rawLimit, 10);\n    if (isNaN(timeLimitSec)) timeLimitSec = 20;\n\n    console.log(\"Question\", questionID,\n                \"quizNumber\", quizNumber,\n                \"rawLimit =\", rawLimit,\n                \"timeLimitSec =\", timeLimitSec);\n\n    \/\/ ---- Cleanup any existing timers for this question ----\n    const globalTimerKey = `__timers_q${questionID}`;\n    if (window[globalTimerKey] && Array.isArray(window[globalTimerKey])) {\n        window[globalTimerKey].forEach(clearTimeout);\n    }\n    window[globalTimerKey] = [];\n\n    \/\/ ---- Timing values ----\n    var totalTime    = timeLimitSec * 1000;\n    var message2Time = totalTime - 5000;   \/\/ 5 seconds remaining (for both 20s and 40s)\n    var startTime    = new Date();\n    var hasRecorded  = false;\n\n    \/\/ IDs\n    var msg1Id    = `msg1_q${questionID}`;\n    var msg2Id    = `msg2_q${questionID}`;\n    var confirmId = `confirm_q${questionID}`;\n\n    \/\/ Remove prior message boxes\n    [msg1Id, msg2Id, confirmId].forEach(id => {\n        const existing = document.getElementById(id);\n        if (existing) existing.remove();\n    });\n\n    function createMessage(id, text, bgColor, textColor) {\n        var div = document.createElement(\"div\");\n        div.id = id;\n        div.innerText = text;\n        Object.assign(div.style, {\n            position: \"fixed\",\n            top: \"20px\",\n            left: \"50%\",\n            transform: \"translateX(-50%)\",\n            backgroundColor: bgColor,\n            color: textColor,\n            padding: \"12px 20px\",\n            border: \"1px solid #ddd\",\n            borderRadius: \"8px\",\n            fontFamily: \"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\",\n            fontSize: \"14px\",\n            fontWeight: \"400\",\n            boxShadow: \"0 4px 12px rgba(0,0,0,0.1)\",\n            zIndex: \"9999\",\n            display: \"none\"\n        });\n        document.body.appendChild(div);\n        return div;\n    }\n\n    \/\/ =====================================================\n    \/\/  MESSAGES\n    \/\/  - 40s (slow): message at 20s elapsed + 5s remaining\n    \/\/  - 20s (fast): only 5s remaining\n    \/\/ =====================================================\n\n    \/\/ Mid-point warning only for 40s condition \n    var msgDiv1 = null;\n    var midWarningTimeMs = null;\n\n    if (timeLimitSec === 40) {\n        midWarningTimeMs = 20000; \/\/ 20 seconds elapsed (20 seconds left)\n        msgDiv1 = createMessage(\n            msg1Id,\n            \"20 seconds to go\",\n            \"#eaeaea\",\n            \"#333\"\n        );\n    }\n\n    \/\/ 5-second warning: always used\n    var msgDiv2 = createMessage(\n        msg2Id,\n        \"5 seconds to go, please submit your answer\",\n        \"#eaeaea\",\n        \"#333\"\n    );\n\n\n    \/\/ ---- Mid warning (only 40s condition) ----   \n    if (msgDiv1 && midWarningTimeMs !== null) {\n        window[globalTimerKey].push(setTimeout(function () {\n            msgDiv1.style.display = \"block\";\n            setTimeout(function () { msgDiv1.style.display = \"none\"; }, 2000);\n        }, midWarningTimeMs));\n    }\n\n    \/\/ ---- 5-second warning (both conditions) ----\n    window[globalTimerKey].push(setTimeout(function () {\n        msgDiv2.style.display = \"block\";\n        setTimeout(function () { msgDiv2.style.display = \"none\"; }, 2000);\n    }, message2Time));\n\n    \/\/ ---- Auto-submit at timeout ----\n    window[globalTimerKey].push(setTimeout(function () {\n        if (!hasRecorded) {\n            hasRecorded = true;\n\n            \/\/ Record full time limit if auto-submitted\n            Qualtrics.SurveyEngine.setEmbeddedData(\n                \"TimeOnQuestion\" + questionID,\n                timeLimitSec.toFixed(2)\n            );\n\n            \/\/ If no answer, force a value (adapt selector to your question type)\n            var inputField = jQuery(\"input[type='text']\").first();\n            inputField.val(\"0\");\n            inputField.trigger(\"input\");\n            inputField.blur();\n\n            setTimeout(function () {\n                const nextButton = document.getElementById(\"NextButton\");\n                if (nextButton) nextButton.click();\n            }, 300);\n        }\n    }, totalTime));\n\n    \/\/ ---- Manual submit ----\n    jQuery(\"#NextButton\").on(\"click\", function (event) {\n        if (!hasRecorded) {\n            event.preventDefault();\n            recordClickTime();\n        }\n    });\n\n    function recordClickTime() {\n        if (hasRecorded) return;\n        hasRecorded = true;\n\n        var endTime = new Date();\n        var elapsed = (endTime - startTime) \/ 1000;\n        Qualtrics.SurveyEngine.setEmbeddedData(\n            \"TimeOnQuestion\" + questionID,\n            elapsed.toFixed(2)\n        );\n\n        \/\/ Clear the timers once the participant has answered\n        window[globalTimerKey].forEach(clearTimeout);\n        window[globalTimerKey] = [];\n\n\n        setTimeout(function () {\n            confirmDiv.style.display = \"none\";\n            Qualtrics.SurveyEngine.clickNextButton();\n        }, 500);  \n    }\n});\n\n\n\/\/ ========================================================\n\/\/            DISABLE COPY \/ PASTE \/ SELECTION  \n\/\/ ========================================================\n\nQualtrics.SurveyEngine.addOnload(function() {\n    document.body.style.userSelect = \"none\";\n    document.body.style.webkitUserSelect = \"none\";\n    document.body.style.msUserSelect = \"none\";\n    document.body.style.mozUserSelect = \"none\";\n\n    document.addEventListener(\"contextmenu\", function(e) { e.preventDefault(); });\n    document.addEventListener(\"copy\",        function(e) { e.preventDefault(); });\n    document.addEventListener(\"paste\",       function(e) { e.preventDefault(); });\n    document.addEventListener(\"cut\",         function(e) { e.preventDefault(); });\n    document.addEventListener(\"dragstart\",   function(e) { e.preventDefault(); });\n});","DefaultChoices":false,"QuestionType":"TE","Selector":"SL","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel","InputWidth":675,"InputHeight":29},"QuestionDescription":"79820 + 2817 + 12 + 298","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"ContentType","MinChars":"1","TotalChars":"1","ContentType":"ValidNumber","ValidDateType":"DateWithFormat","ValidPhoneType":"ValidUSPhone","ValidZipType":"ValidUSZip","ValidNumber":{"Min":"","Max":"","NumDecimals":"0"}}},"GradingData":[{"Grades":{"SC_ehBDTCVctdnz22a":"1"},"TextEntry":"82947"},{"Grades":{"SC_ehBDTCVctdnz22a":"1"},"TextEntry":"82947 "},{"Grades":{"SC_ehBDTCVctdnz22a":"1"},"TextEntry":" 82947 "}],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"9372894 + 33 + 297 + 55 + 170027 =","DataExportTag":"Q2.5","QuestionID":"QID130"}},{"SurveyID":"SV_emk6lgDslmVI5bE","Element":"SQ","PrimaryAttribute":"QID133","SecondaryAttribute":"Quiz 1:\u00a0 For this quiz, you will have 40 seconds to answer each question. Once you click submit,...","TertiaryAttribute":null,"Payload":{"QuestionText":"Quiz 1:&nbsp;<br>\n<br>\nFor this quiz, you will have <strong>40 seconds<\/strong> to answer each question.<br>\nOnce you click submit, your answer and response-time will be saved and you will advance straight away to the next question. If after 40 seconds you have not submitted an answer, you will automatically proceed to the next question. A message will pop up when you 20 seconds left, and when you have 5 seconds left.<br>\n<br>\nAs a reminder, please stick to mental calculations; your compensation does not depend on your performance.<br>\n<br>\nAs soon as you proceed to the next page, your time for the first question will start.","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Quiz 1:\u00a0 For this quiz, you will have 40 seconds to answer each question. Once you click submit,...","Choices":[],"ChoiceOrder":[],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":1,"NextAnswerId":1,"QuestionText_Unsafe":"This is the Quiz phase, in which you will complete three short quizzes. In each quiz, you will be presented with five or six numerical questions and asked to try to provide the correct answers. <br><br>For each quiz, you will be told how much time you have to answer the questions. Please read the instructions carefully.\n<br><br>Your compensation does not depend on whether you get the questions right or wrong, or on how fast you answer. <br><br>The task is to find the correct answer on your own, without the aid of any calculation tools (including writing it down, please stick to mental calculations).","DataExportTag":"Q133","QuestionID":"QID133","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n    \/\/ Clear any leftover timers from previous quiz questions\n    Object.keys(window).forEach(function(key) {\n        if (key.startsWith(\"__timers_q\")) {\n            try { window[key].forEach(clearTimeout); } catch(e) {}\n            window[key] = [];\n        }\n    });\n});"}},{"SurveyID":"SV_emk6lgDslmVI5bE","Element":"SQ","PrimaryAttribute":"QID135","SecondaryAttribute":"Quiz 2:\u00a0 For this quiz, you will have ${e:\/\/Field\/Quiz2Limit} seconds\u00a0to answer each question. On.","TertiaryAttribute":null,"Payload":{"QuestionText":"Quiz 2:&nbsp;<br>\n<br>\nFor this quiz, you will have <strong>${e:\/\/Field\/Quiz2Limit} seconds&nbsp;<\/strong>to answer each question.<br>\nOnce you click submit, your answer and response-time will be saved and you will advance straight away to the next question. If after ${e:\/\/Field\/Quiz2Limit} seconds you have not submitted an answer, you will automatically proceed to the next question. A message will pop up when you have five seconds left.<br>\n<br>\nAs a reminder, please stick to mental calculations; your compensation does not depend on your performance.<br>\n<br>\nAs soon as you proceed to the next page, your time for the first question will start.","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Quiz 2:\u00a0 For this quiz, you will have ${e:\/\/Field\/Quiz2Limit} seconds\u00a0to answer each question. On...","Choices":[],"ChoiceOrder":[],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":1,"NextAnswerId":1,"QuestionText_Unsafe":"Quiz 1:&nbsp;<br>\n<br>\nFor this quiz, you will have <strong>30 seconds<\/strong> to answer each question.<br>Once you click submit, your answer and response-time will be saved and you will advance straight away to the next question. If after 30 seconds you have not submitted an answer, you will automatically proceed to the next question. A message will pop up when you have five seconds left. <br><br>As a reminder, please stick to mental calculations; your compensation does not depend on your performance. <br><br>As soon as you proceed to the next page, your time for the first question will start.\u201d\n<br>","DataExportTag":"Q135","QuestionID":"QID135","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n    \/\/ Clear any leftover timers from previous quiz questions\n    Object.keys(window).forEach(function(key) {\n        if (key.startsWith(\"__timers_q\")) {\n            try { window[key].forEach(clearTimeout); } catch(e) {}\n            window[key] = [];\n        }\n    });\n});"}},{"SurveyID":"SV_emk6lgDslmVI5bE","Element":"SQ","PrimaryAttribute":"QID136","SecondaryAttribute":"Quiz 3:\u00a0 For this quiz, you will have ${e:\/\/Field\/Quiz3Limit} seconds to answer each question. On..","TertiaryAttribute":null,"Payload":{"QuestionText":"Quiz 3:&nbsp;<br>\n<br>\nFor this quiz, you will have <strong>${e:\/\/Field\/Quiz3Limit} seconds<\/strong> to answer each question.<br>\nOnce you click submit, your answer and response-time will be saved and you will advance straight away to the next question. If after ${e:\/\/Field\/Quiz3Limit} seconds seconds you have not submitted an answer, you will automatically proceed to the next question. A message will pop up when you have five&nbsp;seconds left.<br>\n<br>\nAs a reminder, please stick to mental calculations; your compensation does not depend on your performance.<br>\n<br>\nAs soon as you proceed to the next page, your time for the first question will start.","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Quiz 3:\u00a0 For this quiz, you will have ${e:\/\/Field\/Quiz3Limit} seconds to answer each question. On...","Choices":[],"ChoiceOrder":[],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":1,"NextAnswerId":1,"QuestionText_