orEach(id => {\n        const existing = document.getElementById(id);\n        if (existing) existing.remove();\n    });\n\n    \/\/ Message creation\n    function createMessage(id, text, bgColor, textColor) {\n        var div = document.createElement(\"div\");\n        div.id = id;\n        div.innerText = text;\n        Object.assign(div.style, {\n            position: \"fixed\",\n            top: \"20px\",\n            left: \"50%\",\n            transform: \"translateX(-50%)\",\n            backgroundColor: bgColor,\n            color: textColor,\n            padding: \"12px 20px\",\n            border: \"1px solid #ddd\",\n            borderRadius: \"8px\",\n            fontFamily: \"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\",\n            fontSize: \"14px\",\n            fontWeight: \"400\",\n            boxShadow: \"0 4px 12px rgba(0,0,0,0.1)\",\n            zIndex: \"9999\",\n            display: \"none\"\n        });\n        document.body.appendChild(div);\n        return div;\n    }\n\n    var msgDiv1 = createMessage(msg1Id, \"20 seconds to go\", \"#eaeaea\", \"#333\");\n    var msgDiv2 = createMessage(msg2Id, \"5 seconds to go, please submit your answer\", \"#eaeaea\", \"#333\");\n    var confirmDiv = createMessage(confirmId, \"\", \"#ffffff\", \"#333333\");\n\n    \/\/ Timed warning messages\n    window[globalTimerKey].push(setTimeout(() => {\n        msgDiv1.style.display = \"block\";\n        setTimeout(() => { msgDiv1.style.display = \"none\"; }, 2000);\n    }, message1Time));\n\n    window[globalTimerKey].push(setTimeout(() => {\n        msgDiv2.style.display = \"block\";\n        setTimeout(() => { msgDiv2.style.display = \"none\"; }, 2000);\n    }, message2Time));\n\n\t\t\/\/ Timeout fallback at 40s\n\twindow[globalTimerKey].push(setTimeout(() => {\n\t\tif (!hasRecorded) {\n\t\t\thasRecorded = true;\n\t\t\tvar elapsed = 40.00;\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(\"TimeOnQuestion\" + questionID, elapsed.toFixed(2));\n\n\t\t\t\/\/ Insert \"0\" into the input field\n\t\t\tvar inputField = jQuery(\"input[type='text']\").first();\n\t\t\tinputField.val(\"0\");\n\t\t\tinputField.trigger(\"input\"); \/\/ notify Qualtrics of change\n\t\t\tinputField.blur(); \/\/ trigger any blur validation\n\n\t\t\t\/\/ Logically simulate user interaction to ensure Qualtrics sees it\n\t\t\tsetTimeout(() => {\n\t\t\t\tconst nextButton = document.getElementById(\"NextButton\");\n\t\t\t\tif (nextButton) {\n\t\t\t\t\tnextButton.click(); \/\/ force the click\n\t\t\t\t} else {\n\t\t\t\t\tconsole.error(\"NextButton not found\");\n\t\t\t\t}\n\t\t\t}, 300); \/\/ wait a bit to let Qualtrics validation register the change\n\t\t}\n\t}, totalTime));\n\n    \/\/ Manual submit\n    jQuery(\"#NextButton\").on('click', function(event) {\n        if (!hasRecorded) {\n            event.preventDefault(); \/\/ prevent immediate navigation\n            recordClickTime();\n        }\n    });\n\n    function recordClickTime() {\n        if (hasRecorded) return;\n        hasRecorded = true;\n\n        var endTime = new Date();\n        var elapsed = (endTime - startTime) \/ 1000;\n        Qualtrics.SurveyEngine.setEmbeddedData(\"TimeOnQuestion\" + questionID, elapsed.toFixed(2));\n\n        \/\/ Clear timers\n        window[globalTimerKey].forEach(clearTimeout);\n        window[globalTimerKey] = [];\n\n        \/\/ Wait 2 seconds then advance\n        setTimeout(() => {\n            confirmDiv.style.display = \"none\";\n            Qualtrics.SurveyEngine.clickNextButton();\n        }, 5000);\n    }\n});\n\nQualtrics.SurveyEngine.addOnUnload(function() {\n    var questionID = 1000;\n    const globalTimerKey = `__timers_q${questionID}`;\n    if (window[globalTimerKey]) {\n        window[globalTimerKey].forEach(clearTimeout);\n        window[globalTimerKey] = [];\n    }\n\n    var ids = [`msg1_q${questionID}`, `msg2_q${questionID}`, `confirm_q${questionID}`];\n    ids.forEach(id => {\n        var el = document.getElementById(id);\n        if (el) el.remove();\n    });\n});\n\n\nQualtrics.SurveyEngine.addOnload(function() {\n    \/\/ Disable text selection\n    document.body.style.userSelect = \"none\";\n    document.body.style.webkitUserSelect = \"none\";\n    document.body.style.msUserSelect = \"none\";\n    document.body.style.mozUserSelect = \"none\";\n\n    \/\/ Disable right-click context menu\n    document.addEventListener(\"contextmenu\", function(e) {\n        e.preventDefault();\n    });\n\n    \/\/ Disable copy\n    document.addEventListener(\"copy\", function(e) {\n        e.preventDefault();\n    });\n\n    \/\/ Disable paste\n    document.addEventListener(\"paste\", function(e) {\n        e.preventDefault();\n    });\n\n    \/\/ Disable cut\n    document.addEventListener(\"cut\", function(e) {\n        e.preventDefault();\n    });\n\n    \/\/ Also disable drag selection\n    document.addEventListener(\"dragstart\", function(e) {\n        e.preventDefault();\n    });\n});","DefaultChoices":false,"DataExportTag":"Q1000","QuestionType":"TE","Selector":"SL","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel","InputWidth":675,"InputHeight":29},"QuestionDescription":"9372894 + 33 + 297 + 55 + 170027","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"ContentType","MinChars":"1","TotalChars":"1","ContentType":"ValidNumber","ValidDateType":"DateWithFormat","ValidPhoneType":"ValidUSPhone","ValidZipType":"ValidUSZip","ValidNumber":{"Min":"","Max":"","NumDecimals":"0"}}},"GradingData":[{"Grades":{"SC_ehBDTCVctdnz22a":"1"},"TextEntry":"92575"},{"Grades":{"SC_ehBDTCVctdnz22a":"1"},"TextEntry":"92575 "},{"Grades":{"SC_ehBDTCVctdnz22a":"1"},"TextEntry":" 92575 "}],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID124"}},{"SurveyID":"SV_emk6lgDslmVI5bE","Element":"SQ","PrimaryAttribute":"QID125","SecondaryAttribute":"340 + 491 =","TertiaryAttribute":null,"Payload":{"QuestionText":"340 + 491 =","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n    \/***** CONFIGURE THESE TWO LINES PER QUESTION *****\/\n    var questionID = 2.1;   \/\/ question ID\n    var quizNumber = 2;     \/\/ 2 for Quiz 2 questions, 3 for Quiz 3 questions\n    \/***************************************************\/\n\n    \/\/ ---- Get time limit from Embedded Data ----\n    \/\/ Set Quiz2Limit \/ Quiz3Limit to 20 (fast) or 40 (slow)\n    var rawLimit;\n    if (quizNumber === 2) {\n        rawLimit = Qualtrics.SurveyEngine.getEmbeddedData(\"Quiz2Limit\");\n    } else if (quizNumber === 3) {\n        rawLimit = Qualtrics.SurveyEngine.getEmbeddedData(\"Quiz3Limit\");\n    } else {\n        rawLimit = \"20\"; \n    }\n\n    var timeLimitSec = parseInt(rawLimit, 10);\n    if (isNaN(timeLimitSec)) timeLimitSec = 20;\n\n    console.log(\"Question\", questionID,\n                \"quizNumber\", quizNumber,\n                \"rawLimit =\", rawLimit,\n                \"timeLimitSec =\", timeLimitSec);\n\n    \/\/ ---- Cleanup any existing timers for this question ----\n    const globalTimerKey = `__timers_q${questionID}`;\n    if (window[globalTimerKey] && Array.isArray(window[globalTimerKey])) {\n        window[globalTimerKey].forEach(clearTimeout);\n    }\n    window[globalTimerKey] = [];\n\n    \/\/ ---- Timing values ----\n    var totalTime    = timeLimitSec * 1000;\n    var message2Time = totalTime - 5000;   \/\/ 5 seconds remaining (for both 20s and 40s)\n    var startTime    = new Date();\n    var hasRecorded  = false;\n\n    \/\/ IDs\n    var msg1Id    = `msg1_q${questionID}`;\n    var msg2Id    = `msg2_q${questionID}`;\n    var confirmId = `confirm_q${questionID}`;\n\n    \/\/ Remove prior message boxes\n    [msg1Id, msg2Id, confirmId].forEach(id => {\n        const existing = document.getElementById(id);\n        if (existing) existing.remove();\n    });\n\n    function createMessage(id, text, bgColor, textColor) {\n        var div = document.createElement(\"div\");\n        div.id = id;\n        div.innerText = text;\n        Object.assign(div.style, {\n            position: \"fixed\",\n            top: \"20px\",\n            left: \"50%\",\n            transform: \"translateX(-50%)\",\n            backgroundColor: bgColor,\n            color: textColor,\n            padding: \"12px 20px\",\n            border: \"1px solid #ddd\",\n            borderRadius: \"8px\",\n            fontFamily: \"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\",\n            fontSize: \"14px\",\n            fontWeight: \"400\",\n            boxShadow: \"0 4px 12px rgba(0,0,0,0.1)\",\n            zIndex: \"9999\",\n            display: \"none\"\n        });\n        document.body.appendChild(div);\n        return div;\n    }\n\n    \/\/ =====================================================\n    \/\/  MESSAGES\n    \/\/  - 40s (slow): message at 20s elapsed + 5s remaining\n    \/\/  - 20s (fast): only 5s remaining\n    \/\/ =====================================================\n\n    \/\/ Mid-point warning only for 40s condition \n    var msgDiv1 = null;\n    var midWarningTimeMs = null;\n\n    if (timeLimitSec === 40) {\n        midWarningTimeMs = 20000; \/\/ 20 seconds elapsed (20 seconds left)\n        msgDiv1 = createMessage(\n            msg1Id,\n            \"20 seconds to go\",\n            \"#eaeaea\",\n            \"#333\"\n        );\n    }\n\n    \/\/ 5-second warning: always used\n    var msgDiv2 = createMessage(\n        msg2Id,\n        \"5 seconds to go, please submit your answer\",\n        \"#eaeaea\",\n        \"#333\"\n    );\n\n\n    \/\/ ---- Mid warning (only 40s condition) ----   \n    if (msgDiv1 && midWarningTimeMs !== null) {\n        window[globalTimerKey].push(setTimeout(function () {\n            msgDiv1.style.display = \"block\";\n            setTimeout(function () { msgDiv1.style.display = \"none\"; }, 2000);\n        }, midWarningTimeMs));\n    }\n\n    \/\/ ---- 5-second warning (both conditions) ----\n    window[globalTimerKey].push(setTimeout(function () {\n        msgDiv2.style.display = \"block\";\n        setTimeout(function () { msgDiv2.style.display = \"none\"; }, 2000);\n    }, message2Time));\n\n    \/\/ ---- Auto-submit at timeout ----\n    window[globalTimerKey].push(setTimeout(function () {\n        if (!hasRecorded) {\n            hasRecorded = true;\n\n            \/\/ Record full time limit if auto-submitted\n            Qualtrics.SurveyEngine.setEmbeddedData(\n                \"TimeOnQuestion\" + questionID,\n                timeLimitSec.toFixed(2)\n            );\n\n            \/\/ If no answer, force a value (adapt selector to your question type)\n            var inputField = jQuery(\"input[type='text']\").first();\n            inputField.val(\"0\");\n            inputField.trigger(\"input\");\n            inputField.blur();\n\n            setTimeout(function () {\n                const nextButton = document.getElementById(\"NextButton\");\n                if (nextButton) nextButton.click();\n            }, 300);\n        }\n    }, totalTime));\n\n    \/\/ ---- Manual submit ----\n    jQuery(\"#NextButton\").on(\"click\", function (event) {\n        if (!hasRecorded) {\n            event.preventDefault();\n            recordClickTime();\n        }\n    });\n\n    function recordClickTime() {\n        if (hasRecorded) return;\n        hasRecorded = true;\n\n        var endTime = new Date();\n        var elapsed = (endTime - startTime) \/ 1000;\n        Qualtrics.SurveyEngine.setEmbeddedData(\n            \"TimeOnQuestion\" + questionID,\n            elapsed.toFixed(2)\n        );\n\n        \/\/ Clear the timers once the participant has answered\n        window[globalTimerKey].forEach(clearTimeout);\n        window[globalTimerKey] = [];\n\n\n        setTimeout(function () {\n            confirmDiv.style.display = \"none\";\n            Qualtrics.SurveyEngine.clickNextButton();\n        }, 500);  \n    }\n});\n\n\n\/\/ ========================================================\n\/\/            DISABLE COPY \/ PASTE \/ SELECTION  \n\/\/ ========================================================\n\nQualtrics.SurveyEngine.addOnload(function() {\n    document.body.style.userSelect = \"none\";\n    document.body.style.webkitUserSelect = \"none\";\n    document.body.style.msUserSelect = \"none\";\n    document.body.style.mozUserSelect = \"none\";\n\n    document.addEventListener(\"contextmenu\", function(e) { e.preventDefault(); });\n    document.addEventListener(\"copy\",        function(e) { e.preventDefault(); });\n    document.addEventListener(\"paste\",       function(e) { e.preventDefault(); });\n    document.addEventListener(\"cut\",         function(e) { e.preventDefault(); });\n    document.addEventListener(\"dragstart\",   function(e) { e.preventDefault(); });\n});","DefaultChoices":false,"QuestionType":"TE","Selector":"SL","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","InputWidth":675,"InputHeight":29},"QuestionDescription":"340 + 491 =","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"ContentType","MinChars":"1","TotalChars":"1","ContentType":"ValidNumber","ValidDateType":"DateWithFormat","ValidPhoneType":"ValidUSPhone","ValidZipType":"ValidUSZip","ValidNumber":{"Min":"","Max":"","NumDecimals":"0"}}},"GradingData":[{"Grades":{"SC_ehBDTCVctdnz22a":"1"},"TextEntry":"831"},{"Grades":{"SC_ehBDTCVctdnz22a":"1"},"TextEntry":"831 "},{"Grades":{"SC_ehBDTCVctdnz22a":"1"},"TextEntry":" 831 "}],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"390 + 431 =","DataExportTag":"Q2.1","QuestionID":"QID125"}},{"SurveyID":"SV_emk6lgDslmVI5bE","Element":"SQ","PrimaryAttribute":"QID126","SecondaryAttribute":"3219 + 3588","TertiaryAttribute":null,"Payload":{"QuestionText":"3219 + 3588 =&nbsp;","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n    \/***** CONFIGURE THESE TWO LINES PER QUESTION *****\/\n    var questionID = 2.2;   \/\/ question ID\n    var quizNumber = 2;     \/\/ 2 for Quiz 2 questions, 3 for Quiz 3 questions\n    \/***************************************************\/\n\n    \/\/ ---- Get time limit from Embedded Data ----\n    \/\/ Set Quiz2Limit \/ Quiz3Limit to 20 (fast) or 40 (slow)\n    var rawLimit;\n    if (quizNumber === 2) {\n        rawLimit = Qualtrics.SurveyEngine.getEmbeddedData(\"Quiz2Limit\");\n    } else if (quizNumber === 3) {\n        rawLimit = Qualtrics.SurveyEngine.getEmbeddedData(\"Quiz3Limit\");\n    } else {\n        rawLimit = \"20\"; \n    }\n\n    var timeLimitSec = parseInt(rawLimit, 10);\n    if (isNaN(timeLimitSec)) timeLimitSec = 20;\n\n    console.log(\"Question\", questionID,\n                \"quizNumber\", quizNumber,\n                \"rawLimit =\", rawLimit,\n                \"timeLimitSec =\", timeLimitSec);\n\n    \/\/ ---- Cleanup any existing timers for this question ----\n    const globalTimerKey = `__timers_q${questionID}`;\n    if (window[globalTimerKey] && Array.isArray(window[globalTimerKey])) {\n        window[globalTimerKey].forEach(clearTimeout);\n    }\n    window[globalTimerKey] = [];\n\n    \/\/ ---- Timing values ----\n    var totalTime    = timeLimitSec * 1000;\n    var message2Time = totalTime - 5000;   \/\/ 5 seconds remaining (for both 20s and 40s)\n    var startTime    = new Date();\n    var hasRecorded  = false;\n\n    \/\/ IDs\n    var msg1Id    = `msg1_q${questionID}`;\n    var msg2Id    = `msg2_q${questionID}`;\n    var confirmId = `confirm_q${questionID}`;\n\n    \/\/ Remove prior message boxes\n    [msg1Id, msg2Id, confirmId].forEach(id => {\n        const existing = document.getElementById(id);\n        if (existing) existing.remove();\n    });\n\n    function createMessage(id, text, bgColor, textColor) {\n        var div = document.createElement(\"div\");\n        div.id = id;\n        div.innerText = text;\n        Object.assign(div.style, {\n            position: \"fixed\",\n            top: \"20px\",\n            left: \"50%\",\n            transform: \"translateX(-50%)\",\n            backgroundColor: bgColor,\n            color: textColor,\n            padding: \"12px 20px\",\n            border: \"1px solid #ddd\",\n            borderRadius: \"8px\",\n            fontFamily: \"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\",\n            fontSize: \"14px\",\n            fontWeight: \"400\",\n            boxShadow: \"0 4px 12px rgba(0,0,0,0.1)\",\n            zIndex: \"9999\",\n            display: \"none\"\n        });\n        document.body.appendChild(div);\n        return div;\n    }\n\n    \/\/ =====================================================\n    \/\/  MESSAGES\n    \/\/  - 40s (slow): message at 20s elapsed + 5s remaining\n    \/\/  - 20s (fast): only 5s remaining\n    \/\/ =====================================================\n\n    \/\/ Mid-point warning only for 40s condition \n    var msgDiv1 = null;\n    var midWarningTimeMs = null;\n\n    if (timeLimitSec === 40) {\n        midWarningTimeMs = 20000; \/\/ 20 seconds elapsed (20 seconds left)\n        msgDiv1 = createMessage(\n            msg1Id,\n            \"20 seconds to go\",\n            \"#eaeaea\",\n            \"#333\"\n        );\n    }\n\n    \/\/ 5-second warning: always used\n    var msgDiv2 = createMessage(\n        msg2Id,\n        \"5 seconds to go, please submit your answer\",\n        \"#eaeaea\",\n        \"#333\"\n    );\n\n\n    \/\/ ---- Mid warning (only 40s condition) ----   \n    if (msgDiv1 && midWarningTimeMs !== null) {\n        window[globalTimerKey].push(setTimeout(function () {\n            msgDiv1.style.display = \"block\";\n            setTimeout(function () { msgDiv1.style.display = \"none\"; }, 2000);\n        }, midWarningTimeMs));\n    }\n\n    \/\/ ---- 5-second warning (both conditions) ----\n    window[globalTimerKey].push(setTimeout(function () {\n        msgDiv2.style.display = \"block\";\n        setTimeout(function () { msgDiv2.style.display = \"none\"; }, 2000);\n    }, message2Time));\n\n    \/\/ ---- Auto-submit at timeout ----\n    window[globalTimerKey].push(setTimeout(function () {\n        if (!hasRecorded) {\n            hasRecorded = true;\n\n            \/\/ Record full time limit if auto-submitted\n            Qualtrics.SurveyEngine.setEmbeddedData(\n                \"TimeOnQuestion\" + questionID,\n                timeLimitSec.toFixed(2)\n            );\n\n            \/\/ If no answer, force a value (adapt selector to your question type)\n            var inputField = jQuery(\"input[type='text']\").first();\n            inputField.val(\"0\");\n            inputField.trigger(\"input\");\n            inputField.blur();\n\n            setTimeout(function () {\n                const nextButton = document.getElementById(\"NextButton\");\n                if (nextButton) nextButton.click();\n            }, 300);\n        }\n    }, totalTime));\n\n    \/\/ ---- Manual submit ----\n    jQuery(\"#NextButton\").on(\"click\", function (event) {\n        if (!hasRecorded) {\n            event.preventDefault();\n            recordClickTime();\n        }\n    });\n\n    function recordClickTime() {\n        if (hasRecorded) return;\n        hasRecorded = true;\n\n        var endTime = new Date();\n        var elapsed = (endTime - startTime) \/ 1000;\n        Qualtrics.SurveyEngine.setEmbeddedData(\n            \"TimeOnQuestion\" + questionID,\n            elapsed.toFixed(2)\n        );\n\n        \/\/ Clear the timers once the participant has answered\n        window[globalTimerKey].forEach(clearTimeout);\n        window[globalTimerKey] = [];\n\n\n        setTimeout(function () {\n            confirmDiv.style.display = \"none\";\n            Qualtrics.SurveyEngine.clickNextButton();\n        }, 500);  \n    }\n});\