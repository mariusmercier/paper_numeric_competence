        \"timeLimitSec =\", timeLimitSec);\n\n    \/\/ ---- Cleanup any existing timers for this question ----\n    const globalTimerKey = `__timers_q${questionID}`;\n    if (window[globalTimerKey] && Array.isArray(window[globalTimerKey])) {\n        window[globalTimerKey].forEach(clearTimeout);\n    }\n    window[globalTimerKey] = [];\n\n    \/\/ ---- Timing values ----\n    var totalTime    = timeLimitSec * 1000;\n    var message2Time = totalTime - 5000;   \/\/ 5 seconds remaining (for both 20s and 40s)\n    var startTime    = new Date();\n    var hasRecorded  = false;\n\n    \/\/ IDs\n    var msg1Id    = `msg1_q${questionID}`;\n    var msg2Id    = `msg2_q${questionID}`;\n    var confirmId = `confirm_q${questionID}`;\n\n    \/\/ Remove prior message boxes\n    [msg1Id, msg2Id, confirmId].forEach(id => {\n        const existing = document.getElementById(id);\n        if (existing) existing.remove();\n    });\n\n    function createMessage(id, text, bgColor, textColor) {\n        var div = document.createElement(\"div\");\n        div.id = id;\n        div.innerText = text;\n        Object.assign(div.style, {\n            position: \"fixed\",\n            top: \"20px\",\n            left: \"50%\",\n            transform: \"translateX(-50%)\",\n            backgroundColor: bgColor,\n            color: textColor,\n            padding: \"12px 20px\",\n            border: \"1px solid #ddd\",\n            borderRadius: \"8px\",\n            fontFamily: \"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\",\n            fontSize: \"14px\",\n            fontWeight: \"400\",\n            boxShadow: \"0 4px 12px rgba(0,0,0,0.1)\",\n            zIndex: \"9999\",\n            display: \"none\"\n        });\n        document.body.appendChild(div);\n        return div;\n    }\n\n    \/\/ =====================================================\n    \/\/  MESSAGES\n    \/\/  - 40s (slow): message at 20s elapsed + 5s remaining\n    \/\/  - 20s (fast): only 5s remaining\n    \/\/ =====================================================\n\n    \/\/ Mid-point warning only for 40s condition \n    var msgDiv1 = null;\n    var midWarningTimeMs = null;\n\n    if (timeLimitSec === 40) {\n        midWarningTimeMs = 20000; \/\/ 20 seconds elapsed (20 seconds left)\n        msgDiv1 = createMessage(\n            msg1Id,\n            \"20 seconds to go\",\n            \"#eaeaea\",\n            \"#333\"\n        );\n    }\n\n    \/\/ 5-second warning: always used\n    var msgDiv2 = createMessage(\n        msg2Id,\n        \"5 seconds to go, please submit your answer\",\n        \"#eaeaea\",\n        \"#333\"\n    );\n\n\n    \/\/ ---- Mid warning (only 40s condition) ----   \n    if (msgDiv1 && midWarningTimeMs !== null) {\n        window[globalTimerKey].push(setTimeout(function () {\n            msgDiv1.style.display = \"block\";\n            setTimeout(function () { msgDiv1.style.display = \"none\"; }, 2000);\n        }, midWarningTimeMs));\n    }\n\n    \/\/ ---- 5-second warning (both conditions) ----\n    window[globalTimerKey].push(setTimeout(function () {\n        msgDiv2.style.display = \"block\";\n        setTimeout(function () { msgDiv2.style.display = \"none\"; }, 2000);\n    }, message2Time));\n\n    \/\/ ---- Auto-submit at timeout ----\n    window[globalTimerKey].push(setTimeout(function () {\n        if (!hasRecorded) {\n            hasRecorded = true;\n\n            \/\/ Record full time limit if auto-submitted\n            Qualtrics.SurveyEngine.setEmbeddedData(\n                \"TimeOnQuestion\" + questionID,\n                timeLimitSec.toFixed(2)\n            );\n\n            \/\/ If no answer, force a value (adapt selector to your question type)\n            var inputField = jQuery(\"input[type='text']\").first();\n            inputField.val(\"0\");\n            inputField.trigger(\"input\");\n            inputField.blur();\n\n            setTimeout(function () {\n                const nextButton = document.getElementById(\"NextButton\");\n                if (nextButton) nextButton.click();\n            }, 300);\n        }\n    }, totalTime));\n\n    \/\/ ---- Manual submit ----\n    jQuery(\"#NextButton\").on(\"click\", function (event) {\n        if (!hasRecorded) {\n            event.preventDefault();\n            recordClickTime();\n        }\n    });\n\n    function recordClickTime() {\n        if (hasRecorded) return;\n        hasRecorded = true;\n\n        var endTime = new Date();\n        var elapsed = (endTime - startTime) \/ 1000;\n        Qualtrics.SurveyEngine.setEmbeddedData(\n            \"TimeOnQuestion\" + questionID,\n            elapsed.toFixed(2)\n        );\n\n        \/\/ Clear the timers once the participant has answered\n        window[globalTimerKey].forEach(clearTimeout);\n        window[globalTimerKey] = [];\n\n\n        setTimeout(function () {\n            confirmDiv.style.display = \"none\";\n            Qualtrics.SurveyEngine.clickNextButton();\n        }, 500);  \n    }\n});\n\n\n\/\/ ========================================================\n\/\/            DISABLE COPY \/ PASTE \/ SELECTION  \n\/\/ ========================================================\n\nQualtrics.SurveyEngine.addOnload(function() {\n    document.body.style.userSelect = \"none\";\n    document.body.style.webkitUserSelect = \"none\";\n    document.body.style.msUserSelect = \"none\";\n    document.body.style.mozUserSelect = \"none\";\n\n    document.addEventListener(\"contextmenu\", function(e) { e.preventDefault(); });\n    document.addEventListener(\"copy\",        function(e) { e.preventDefault(); });\n    document.addEventListener(\"paste\",       function(e) { e.preventDefault(); });\n    document.addEventListener(\"cut\",         function(e) { e.preventDefault(); });\n    document.addEventListener(\"dragstart\",   function(e) { e.preventDefault(); });\n});","DefaultChoices":false,"QuestionType":"TE","Selector":"SL","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","InputWidth":675,"InputHeight":29},"QuestionDescription":"88520 + 1648 + 29 +169 =","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"ContentType","MinChars":"1","TotalChars":"1","ContentType":"ValidNumber","ValidDateType":"DateWithFormat","ValidPhoneType":"ValidUSPhone","ValidZipType":"ValidUSZip","ValidNumber":{"Min":"","Max":"","NumDecimals":"0"}}},"GradingData":[{"Grades":{"SC_ehBDTCVctdnz22a":"1"},"TextEntry":"90366"},{"Grades":{"SC_ehBDTCVctdnz22a":"1"},"TextEntry":"90366 "},{"Grades":{"SC_ehBDTCVctdnz22a":"1"},"TextEntry":" 90366 "}],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionText_Unsafe":"79820 + 2817 + 12 + 298 =&nbsp;","DataExportTag":"Q3.5","QuestionID":"QID141"}},{"SurveyID":"SV_emk6lgDslmVI5bE","Element":"SQ","PrimaryAttribute":"QID143","SecondaryAttribute":"In order to proceed, please confirm that you are not a robot.","TertiaryAttribute":null,"Payload":{"QuestionText":"In order to proceed, please confirm that you are not a robot.","DefaultChoices":false,"DataExportTag":"Captcha","QuestionType":"Captcha","Selector":"V2","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","Align":"left","Theme":"light"},"QuestionDescription":"In order to proceed, please confirm that you are not a robot.","GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID143"}},{"SurveyID":"SV_emk6lgDslmVI5bE","Element":"SQ","PrimaryAttribute":"QID144","SecondaryAttribute":"stim_seen","TertiaryAttribute":null,"Payload":{"QuestionText":"stim_seen","DefaultChoices":{"TEXT":{"Text":"${lm:\/\/Field\/1}"}},"DataExportTag":"stim_seen","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"stim_seen","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID144","DisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID3\/SelectableChoice\/1","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">We invite you to participate in a scientific experiment. Participation requires that you give your informed consent. Before proceeding, please consider the following information:\nThe survey will ta...<\/span> <span class=\"LeftOpDesc\">I give my informed consent to participate in this study.<\/span> <span class=\"OpDesc\">Is Not Displayed<\/span> ","LeftOperand":"q:\/\/QID3\/ChoiceDisplayed\/1","LogicType":"Question","Operator":"NotDisplayed","QuestionID":"QID3","QuestionIDFromLocator":"QID3","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false}}},{"SurveyID":"SV_emk6lgDslmVI5bE","Element":"SQ","PrimaryAttribute":"QID3","SecondaryAttribute":"We invite you to participate in a scientific experiment. Participation requires that you give you...","TertiaryAttribute":null,"Payload":{"QuestionText":"We invite you to participate in a scientific experiment. Participation requires that you give your informed consent. <br><br>Before proceeding, please consider the following information:\n<br><br>The survey will take about 10 minutes to complete.\n\nThere are no risks involved in this study.\n<br>&nbsp;<br>You will be paid for your participation at the posted rate (provided that you complete the whole study).\n\nYour individual privacy will be maintained in all published and written data resulting from the study.\n<br>&nbsp;<br>Participation in this research study is voluntary. You may choose not to participate.\n<br><br>By ticking the box below, and proceeding to the study task you certify that you have read this form, and agreed to participate in accordance with the above conditions.","DefaultChoices":false,"DataExportTag":"free_consent","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"We invite you to participate in a scientific experiment. Participation requires that you give you...","Choices":{"1":{"Display":"I give my informed consent to participate in this study."}},"ChoiceOrder":[1],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":1,"QuestionID":"QID3"}},{"SurveyID":"SV_emk6lgDslmVI5bE","Element":"SQ","PrimaryAttribute":"QID5","SecondaryAttribute":"Imagine you are playing video games with a friend and at some point your friend says: \u201cI don\u2019t w","TertiaryAttribute":null,"Payload":{"QuestionText":"Imagine you are playing video games with a friend and at some point your friend says:\n\u201cI don\u2019t want to play this game anymore! To make sure that you read the instructions, please write the three following words \u2018I pay attention\u2019 in the box below. I really dislike this game, it\u2019s the most overrated game ever.\u201d\nDo you agree with your friend?\n<span style=\"font-size:0; color:#ffffff;\" aria-hidden=\"true\"><\/span>","DefaultChoices":false,"DataExportTag":"attention_check","QuestionType":"TE","Selector":"SL","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Imagine you are playing video games with a friend and at some point your friend says: \u201cI don\u2019t wa...","Choices":{"1":{"Display":"Do you agree with your friend?","TextEntry":"on","TextEntryLength":"Essay"}},"ChoiceOrder":[1],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID5","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/*Place your JavaScript here to run when the page loads*\/\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function() {\n    \/\/ Select the question text using its parent element\n    var questionContainer = this.getQuestionContainer();\n\n    \/\/ Disable text selection\n    questionContainer.style.userSelect = \"none\";\n    questionContainer.style.webkitUserSelect = \"none\";\n    questionContainer.style.msUserSelect = \"none\";\n    questionContainer.style.mozUserSelect = \"none\";\n\n    \/\/ Disable copying\n    questionContainer.addEventListener(\"copy\", function(event) {\n        event.preventDefault();\n    });\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});"}},{"SurveyID":"SV_emk6lgDslmVI5bE","Element":"SQ","PrimaryAttribute":"QID6","SecondaryAttribute":"Thank you very much, you helped science today :) We are researchers interested in human psycholog...","TertiaryAttribute":null,"Payload":{"QuestionText":"Thank you for participating!<br \/>\n<br \/>\nWe sincerely thank you for taking the time to complete this study. Your responses are valuable and will contribute significantly to our research.<br \/>\n<br \/>\nIf you have any questions or would like to know more about the study, please don&rsquo;t hesitate to contact us.<br \/>\n<br \/>\n<strong>Don&#39;t forget to click on the arrow to get your completion code.&nbsp;<\/strong>","DefaultChoices":false,"DataExportTag":"thanks","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel"},"QuestionDescription":"Thank you very much, you helped science today :) We are researchers interested in human psycholog...","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID6"}},{"SurveyID":"SV_emk6lgDslmVI5bE","Element":"SQ","PrimaryAttribute":"QID93","SecondaryAttribute":"390 + 431","TertiaryAttribute":null,"Payload":{"QuestionText":"390 + 431 =","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n    var questionID = 1.1;\n\n    \/\/ --- Global timer cleanup ---\n    const globalTimerKey = `__timers_q${questionID}`;\n    if (window[globalTimerKey] && Array.isArray(window[globalTimerKey])) {\n        window[globalTimerKey].forEach(clearTimeout);\n    }\n    window[globalTimerKey] = [];\n\n    \/\/ Timing setup\n    var message1Time = 20000;\n    var message2Time = 35000;\n    var totalTime = 40000;\n    var startTime = new Date();\n    var hasRecorded = false;\n\n    \/\/ IDs\n    var msg1Id = `msg1_q${questionID}`;\n    var msg2Id = `msg2_q${questionID}`;\n    var confirmId = `confirm_q${questionID}`;\n\n    \/\/ Remove existing message boxes if returning\n    [msg1Id, msg2Id, confirmId].forEach(id => {\n        const existing = document.getElementById(id);\n        if (existing) existing.remove();\n    });\n\n    \/\/ Message creation\n    function createMessage(id, text, bgColor, textColor) {\n        var div = document.createElement(\"div\");\n        div.id = id;\n        div.innerText = text;\n        Object.assign(div.style, {\n            position: \"fixed\",\n            top: \"20px\",\n            left: \"50%\",\n            transform: \"translateX(-50%)\",\n            backgroundColor: bgColor,\n            color: textColor,\n            padding: \"12px 20px\",\n            border: \"1px solid #ddd\",\n            borderRadius: \"8px\",\n            fontFamily: \"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\",\n            fontSize: \"14px\",\n            fontWeight: \"400\",\n            boxShadow: \"0 4px 12px rgba(0,0,0,0.1)\",\n            zIndex: \"9999\",\n            display: \"none\"\n        });\n        document.body.appendChild(div);\n        return div;\n    }\n\n    var msgDiv1 = createMessage(msg1Id, \"20 seconds to go\", \"#eaeaea\", \"#333\");\n    var msgDiv2 = createMessage(msg2Id, \"5 seconds to go, please submit your answer\", \"#eaeaea\", \"#333\");\n    var confirmDiv = createMessage(confirmId, \"\", \"#ffffff\", \"#333333\");\n\n    \/\/ Timed warning messages\n    window[globalTimerKey].push(setTimeout(() => {\n        msgDiv1.style.display = \"block\";\n        setTimeout(() => { msgDiv1.style.display = \"none\"; }, 2000);\n    }, message1Time));\n\n    window[globalTimerKey].push(setTimeout(() => {\n        msgDiv2.style.display = \"block\";\n        setTimeout(() => { msgDiv2.style.display = \"none\"; }, 2000);\n    }, message2Time));\n\n\t\t\/\/ Timeout fallback at 40s\n\twindow[globalTimerKey].push(setTimeout(() => {\n\t\tif (!hasRecorded) {\n\t\t\thasRecorded = true;\n\t\t\tvar elapsed = 40.00;\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(\"TimeOnQuestion\" + questionID, elapsed.toFixed(2));\n\n\t\t\t\/\/ Insert \"0\" into the input field\n\t\t\tvar inputField = jQuery(\"input[type='text']\").first();\n\t\t\tinputField.val(\"0\");\n\t\t\tinputField.trigger(\"input\"); \/\/ notify Qualtrics of change\n\t\t\tinputField.blur(); \/\/ trigger any blur validation\n\n\t\t\t\/\/ Logically simulate user interaction to ensure Qualtrics sees it\n\t\t\tsetTimeout(() => {\n\t\t\t\tconst nextButton = document.getElementById(\"NextButton\");\n\t\t\t\tif (nextButton) {\n\t\t\t\t\tnextButton.click(); \/\/ force the click\n\t\t\t\t} else {\n\t\t\t\t\tconsole.error(\"NextButton not found\");\n\t\t\t\t}\n\t\t\t}, 300); \/\/ wait a bit to let Qualtrics validation register the change\n\t\t}\n\t}, totalTime));\n\n    \/\/ Manual submit\n    jQuery(\"#NextButton\").on('click', function(event) {\n        if (!hasRecorded) {\n            event.preventDefault(); \/\/ prevent immediate navigation\n            recordClickTime();\n        }\n    });\n\n    function recordClickTime() {\n        if (hasRecorded) return;\n        hasRecorded = true;\n\n        var endTime = new Date();\n        var elapsed = (endTime - startTime) \/ 1000;\n        Qualtrics.SurveyEngine.setEmbeddedData(\"TimeOnQuestion\" + questionID, elapsed.toFixed(2));\n\n        \/\/ Clear timers\n        window[globalTimerKey].forEach(clearTimeout);\n        window[globalTimerKey] = [];\n\n        \/\/ Wait 2 seconds then advance\n        setTimeout(() => {\n            confirmDiv.style.display = \"none\";\n            Qualtrics.SurveyEngine.clickNextButton();\n        }, 5000);\n    }\n});\n\nQualtrics.SurveyEngine.addOnUnload(function() {\n    var questionID = 1.1;\n    const globalTimerKey = `__timers_q${questionID}`;\n    if (window[globalTimerKey]) {\n        window[globalTimerKey].forEach(clearTimeout);\n        window[globalTimerKey] = [];\n    }\n\n    var ids = [`msg1_q${questionID}`, `msg2_q${questionID}`, `confirm_q${questionID}`];\n    ids.forEach(id => {\n        var el = document.getElementById(id);\n        if (el) el.remove();\n    });\n});\n\n\nQualtrics.SurveyEngine.addOnload(function() {\n    \/\/ Disable text selection\n    document.body.style.userSelect = \"none\";\n    document.body.style.webkitUserSelect = \"none\";\n    document.body.style.msUserSelect = \"none\";\n    document.body.style.mozUserSelect = \"none\";\n\n    \/\/ Disable right-click context menu\n    document.addEventListener(\"contextmenu\", function(e) {\n        e.preventDefault();\n    });\n\n    \/\/ Disable copy\n    document.addEventListener(\"copy\", function(e) {\n        e.preventDefault();\n    });\n\n    \/\/ Disable paste\n    document.addEventListener(\"paste\", function(e) {\n        e.preventDefault();\n    });\n\n    \/\/ Disable cut\n    document.addEventListener(\"cut\", function(e) {\n        e.preventDefault();\n    });\n\n    \/\/ Also disable drag selection\n    document.addEventListener(\"dragstart\", function(e) {\n        e.preventDefault();\n    });\n});","DefaultChoices":false,"DataExportTag":"Q1.1","QuestionType":"TE","Selector":"SL","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel","InputWidth":675,"InputHeight":29},"QuestionDescription":"390 + 431","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"ContentType","MinChars":"1","TotalChars":"1","ContentType":"ValidNumber","ValidDateType":"DateWithFormat","ValidPhoneType":"ValidUSPhone","ValidZipType":"ValidUSZip","ValidNumber":{"Min":"","Max":"","NumDecimals":"0"}}},"GradingData":[{"Grades":{"SC_ehBDTCVctdnz22a":"1"},"TextEntry":"821"},{"Grades":{"SC_ehBDTCVctdnz22a":"1"},"TextEntry":"821 "},{"Grades":{"SC_ehBDTCVctdnz22a":"1"},"TextEntry":" 821 "}],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID93"}},{"SurveyID":"SV_emk6lgDslmVI5bE","Element":"SQ","PrimaryAttribute":"QID97","SecondaryAttribute":"3719 + 1187","TertiaryAttribute":null,"Payload":{"QuestionText":"3719 + 1187 =","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n    var questionID = 1.2;\n\n    \/\/ --- Global timer cleanup ---\n    const globalTimerKey = `__timers_q${questionID}`;\n    if (window[globalTimerKey] && Array.isArray(window[globalTimerKey])) {\n        window[globalTimerKey].forEach(clearTimeout);\n    }\n    window[globalTimerKey] = [];\n\n    \/\/ Timing setup\n    var message1Time = 20000;\n    var message2Time = 35000;\n    var totalTime = 40000;\n    var startTime = new Date();\n    var hasRecorded = false;\n\n    \/\/ IDs\n    var msg1Id = `msg1_q${questionID}`;\n    var msg2Id = `msg2_q${questionID}`;\n    var confirmId = `confirm_q${questionID}`;\n\n    \/\/ Remove existing message boxes if returning\n    [msg1Id, msg2Id, confirmId].forEach(id => {\n        const existing = document.getElementById(id);\n        if (existing) existing.remove();\n    });\n\n    \/\/ Message creation\n    function createMessage(id, text, bgColor, textColor) {\n        var div = document.createElement(\"div\");\n        div.id = id;\n        div.innerText = text;\n        Object.assign(div.style, {\n            position: \"fixed\",\n            top: \"20px\",\n            left: \"50%\",\n            transform: \"translateX(-50%)\",\n            backgroundColor: bgColor,\n            color: textColor,\n            padding: \"12px 20px\",\n            border: \"1px solid #ddd\",\n            borderRadius: \"8px\",\n            fontFamily: \"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\",\n            fontSize: \"14px\",\n            fontWeight: \"400\",\n            boxShadow: \"0 4px 12px rgba(0,0,0,0.1)\",\n            zIndex: \"9999\",\n            display: \"none\"\n        });\n        document.body.appendChild(div);\n        return div;\n    }\n\n    var msgDiv1 = createMessage(msg1Id, \"20 seconds to go\", \"#eaeaea\", \"#333\");\n    var msgDiv2 = createMessage(msg2Id, \"5 seconds to go, please submit your answer\", \"#eaeaea\", \"#333\");\n    var confirmDiv = createMessage(confirmId, \"\", \"#ffffff\", \"#333333\");\n\n    \/\/ Timed warning messages\n    window[globalTimerKey].push(setTimeout(() => {\n        msgDiv1.style.display = \"block\";\n        setTimeout(() => { msgDiv1.style.display = \"none\"; }, 2000);\n    }, message1Time));\n\n    window[globalTimerKey].push(setTimeout(() => {\n        msgDiv2.style.display = \"block\";\n        setTimeout(() => { msgDiv2.style.display = \"none\"; }, 2000);\n    }, message2Time));\n\n\t\t\/\/ Timeout fallback at 40s\n\twindow[globalTimerKey].push(setTimeout(() => {\n\t\tif (!hasRecorded) {\n\t\t\thasRecorded = true;\n\t\t\tvar elapsed = 40.00;\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(\"TimeOnQuestion\" + questionID, elapsed.toFixed(2));\n\n\t\t\t\/\/ Insert \"0\" into the input field\n\t\t\tvar inputField = jQuery(\"input[type='text']\").first();\n\t\t\tinputField.val(\"0\");\n\t\t\tinputField.trigger(\"input\"); \/\/ notify Qualtrics of change\n\t\t\tinputField.blur(); \/\/ trigger any blur validation\n\n\t\t\t\/\/ Logically simulate user interaction to ensure Qualtrics sees it\n\t\t\tsetTimeout(() => {\n\t\t\t\tconst nextButton = document.getElementById(\"NextButton\");\n\t\t\t\tif (nextButton) {\n\t\t\t\t\tnextButton.click(); \/\/ force the click\n\t\t\t\t} else {\n\t\t\t\t\tconsole.error(\"NextButton not found\");\n\t\t\t\t}\n\t\t\t}, 300); \/\/ wait a bit to let Qualtrics validation register the change\n\t\t}\n\t}, totalTime));\n\n    \/\/ Manual submit\n    jQuery(\"#NextButton\").on('click', function(event) {\n        if (!hasRecorded) {\n            event.preventDefault(); \/\/ prevent immediate navigation\n            recordClickTime();\n        }\n    });\n\n    function recordClickTime() {\n        if (hasRecorded) return;\n        hasRecorded = true;\n\n        var endTime = new Date();\n        var elapsed = (endTime - startTime) \/ 1000;\n        Qualtrics.SurveyEngine.setEmbeddedData(\"TimeOnQuestion\" + questionID, elapsed.toFixed(2));\n\n        \/\/ Clear timers\n        window[globalTimerKey].forEach(clearTimeout);\n        window[globalTimerKey] = [];\n\n        \/\/ Wait 2 seconds then advance\n        setTimeout(() => {\n            confirmDiv.style.display = \"none\";\n            Qualtrics.SurveyEngine.clickNextButton();\n        }, 5000);\n    }\n});\n\nQualtrics.SurveyEngine.addOnUnload(function() {\n    var questionID = 1.2;\n    const globalTimerKey = `__timers_q${questionID}`;\n    if (window[globalTimerKey]) {\n        window[globalTimerKey].forEach(clearTimeout);\n        window[globalTimerKey] = [];\n    }\n\n    var ids = [`msg1_q${questionID}`, `msg2_q${questionID}`, `confirm_q${questionID}`];\n    ids.forEach(id => {\n        var el = document.getElementById(id);\n        if (el) el.remove();\n    });\n});\n\n\nQualtrics.SurveyEngine.addOnload(function() {\n    \/\/ Disable text selection\n    document.body.style.userSelect = \"none\";\n    document.body.style.webkitUserSelect = \"none\";\n    document.body.style.msUserSelect = \"none\";\n    document.body.style.mozUserSelect = \"none\";\n\n    \/\/ Disable right-click context menu\n    document.addEventListener(\"contextmenu\", function(e) {\n        e.preventDefault();\n    });\n\n    \/\/ Disable copy\n    document.addEventListener(\"copy\", function(e) {\n        e.preventDefault();\n    });\n\n    \/\/ Disable paste\n    document.addEventListener(\"paste\", function(e) {\n        e.preventDefault();\n    });\n\n    \/\/ Disable cut\n    document.addEventListener(\"cut\", function(e) {\n        e.preventDefault();\n    });\n\n    \/\/ Also disable drag selection\n    document.addEventListener(\"dragstart\", function(e) {\n        e.preventDefault();\n    });\n});","DefaultChoices":false,"DataExportTag":"Q1.2","QuestionType":"TE","Selector":"SL","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel","InputWidth":675,"InputHeight":29},"QuestionDescription":"3719 + 1187","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"ContentType","MinChars":"1","TotalChars":"1","ContentType":"ValidNumber","ValidDateType":"DateWithFormat","ValidPhoneType":"ValidUSPhone","ValidZipType":"ValidUSZip","ValidNumber":{"Min":"","Max":"","NumDecimals":"0"}}},"GradingData":[{"Grades":{"SC_ehBDTCVctdnz22a":"1"},"TextEntry":"4906"},{"Grades":{"SC_ehBDTCVctdnz22a":"1"},"TextEntry":"4906 "},{"Grades":{"SC_ehBDTCVctdnz22a":"1"},"TextEntry":" 4906 "}],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID97"}},{"SurveyID":"SV_emk6lgDslmVI5bE","Element":"SQ","PrimaryAttribute":"QID99","SecondaryAttribute":"128 + 86 + 716","TertiaryAttribute":null,"Payload":{"QuestionText":"128 + 86 + 716 =","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n    var questionID = 1.3;\n\n    \/\/ --- Global timer cleanup ---\n    const globalTimerKey = `__timers_q${questionID}`;\n    if (window[globalTimerKey] &&