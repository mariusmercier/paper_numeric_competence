Id(\"NextButton\");\n\t\t\t\tif (nextButton) {\n\t\t\t\t\tnextButton.click(); \/\/ force the click\n\t\t\t\t} else {\n\t\t\t\t\tconsole.error(\"NextButton not found\");\n\t\t\t\t}\n\t\t\t}, 300); \/\/ wait a bit to let Qualtrics validation register the change\n\t\t}\n\t}, totalTime));\n\n    \/\/ Manual submit\n    jQuery(\"#NextButton\").on('click', function(event) {\n        if (!hasRecorded) {\n            event.preventDefault(); \/\/ prevent immediate navigation\n            recordClickTime();\n        }\n    });\n\n    function recordClickTime() {\n        if (hasRecorded) return;\n        hasRecorded = true;\n\n        var endTime = new Date();\n        var elapsed = (endTime - startTime) \/ 1000;\n        Qualtrics.SurveyEngine.setEmbeddedData(\"TimeOnQuestion\" + questionID, elapsed.toFixed(2));\n\n        \/\/ Clear timers\n        window[globalTimerKey].forEach(clearTimeout);\n        window[globalTimerKey] = [];\n\n        \/\/ Wait 2 seconds then advance\n        setTimeout(() => {\n            confirmDiv.style.display = \"none\";\n            Qualtrics.SurveyEngine.clickNextButton();\n        }, 5000);\n    }\n});\n\nQualtrics.SurveyEngine.addOnUnload(function() {\n    var questionID = 12;\n    const globalTimerKey = `__timers_q${questionID}`;\n    if (window[globalTimerKey]) {\n        window[globalTimerKey].forEach(clearTimeout);\n        window[globalTimerKey] = [];\n    }\n\n    var ids = [`msg1_q${questionID}`, `msg2_q${questionID}`, `confirm_q${questionID}`];\n    ids.forEach(id => {\n        var el = document.getElementById(id);\n        if (el) el.remove();\n    });\n});\n\n\nQualtrics.SurveyEngine.addOnload(function() {\n    \/\/ Disable text selection\n    document.body.style.userSelect = \"none\";\n    document.body.style.webkitUserSelect = \"none\";\n    document.body.style.msUserSelect = \"none\";\n    document.body.style.mozUserSelect = \"none\";\n\n    \/\/ Disable right-click context menu\n    document.addEventListener(\"contextmenu\", f