r confirmId = `confirm_q${questionID}`;\n\n    \/\/ Remove existing message boxes if returning\n    [msg1Id, msg2Id, confirmId].forEach(id => {\n        const existing = document.getElementById(id);\n        if (existing) existing.remove();\n    });\n\n    \/\/ Message creation\n    function createMessage(id, text, bgColor, textColor) {\n        var div = document.createElement(\"div\");\n        div.id = id;\n        div.innerText = text;\n        Object.assign(div.style, {\n            position: \"fixed\",\n            top: \"20px\",\n            left: \"50%\",\n            transform: \"translateX(-50%)\",\n            backgroundColor: bgColor,\n            color: textColor,\n            padding: \"12px 20px\",\n            border: \"1px solid #ddd\",\n            borderRadius: \"8px\",\n            fontFamily: \"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif\",\n            fontSize: \"14px\",\n            fontWeight: \"400\",\n            boxShadow: \"0 4px 12px rgba(0,0,0,0.1)\",\n            zIndex: \"9999\",\n            display: \"none\"\n        });\n        document.body.appendChild(div);\n        return div;\n    }\n\n    var msgDiv1 = createMessage(msg1Id, \"15 seconds have passed\", \"#eaeaea\", \"#333\");\n    var msgDiv2 = createMessage(msg2Id, \"Only 5 seconds left, please submit your answer!\", \"#eaeaea\", \"#333\");\n    var confirmDiv = createMessage(confirmId, \"\", \"#ffffff\", \"#333333\");\n\n    \/\/ Timed warning messages\n    window[globalTimerKey].push(setTimeout(() => {\n        msgDiv1.style.display = \"block\";\n        setTimeout(() => { msgDiv1.style.display = \"none\"; }, 2000);\n    }, message1Time));\n\n    window[globalTimerKey].push(setTimeout(() => {\n        msgDiv2.style.display = \"block\";\n        setTimeout(() => { msgDiv2.style.display = \"none\"; }, 2000);\n    }, message2Time));\n\n\t\t\/\/ Timeout fallback at 30s\n\twindow[globalTimerKey].push(setTimeout(() => {\n\t\tif (!hasRecorded) {\n\t\t\thasRecorded = true;\n\t\t\tvar elapsed = 30.00;\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(\"TimeOnQuestion\" + questionID, elapsed.toFixed(2));\n\n\t\t\t\/\/ Insert \"0\" into the input field\n\t\t\tvar inputField = jQuery(\"input[type='text']\").first();\n\t\t\tinputField.val(\"0\");\n\t\t\tinputField.trigger(\"input\"); \/\/ notify Qualtrics of change\n\t\t\tinputField.blur(); \/\/ trigger any blur validation\n\n\t\t\t\/\/ Logically simulate user interaction to ensure Qualtrics sees it\n\t\t\tsetTimeout(() => {\n\t\t\t\tconst nextButton = document.getElementById(\"NextButton\");\n\t\t\t\tif (nextButton) {\n\t\t\t\t\tnextButton.click(); \/\/ force the click\n\t\t\t\t} else {\n\t\t\t\t\tconsole.error(\"NextButton not found\");\n\t\t\t\t}\n\t\t\t}, 300); \/\/ wait a bit to let Qualtrics validation register the change\n\t\t}\n\t}, totalTime));\n\n    \/\/ Manual submit\n    jQuery(\"#NextButton\").on('click', function(event) {\n        if (!hasRecorded) {\n            event.preventDefault(); \/\/ prevent immediate navigation\n            recordClickTime();\n        }\n    });\n\n    function recordClickTime() {\n        if (hasRecorded) return;\n        hasRecorded = true;\n\n        var endTime = new Date();\n        var elapsed = (endTime - startTime) \/ 1000;\n        Qualtrics.SurveyEngine.setEmbeddedData(\"TimeOnQuestion\" + questionID, elapsed.toFixed(2));\n\n        \/\/ Clear timers\n        window[globalTimerKey].forEach(clearTimeout);\n        window[globalTimerKey] = [];\n\n        \/\/ Wait 2 seconds then advance\n        setTimeout(() => {\n            confirmDiv.style.display = \"none\";\n            Qualtrics.SurveyEngine.clickNextButton();\n        }, 5000);\n    }\n});\n\nQualtrics.SurveyEngine.addOnUnload(function() {\n    var questionID = 13;\n    const globalTimerKey = `__timers_q${questionID}`;\n    if (window[globalTimerKey]) {\n        window[globalTimerKey].forEach(clearTimeout);\n        window[globalTimerKey] = [];\n    }\n\n    var ids = [`msg1_q${questionID}`, `msg2_q${questionID}`, `confirm_q${questionID}`];\n    ids.forEach(id => {\n        var el = document.getElementById(id);\n        if (el) el.remove();\n    });\n});\n\n\nQualtrics.SurveyEngine.addOnload(function() {\n    \/\/ Disable text selection\n    document.body.style.userSelect = \"none\";\n    document.body.style.webkitUserSelect = \"none\";\n    document.body.style.msUserSelect = \"none\";\n    document.body.style.mozUserSelect = \"none\";\n\n    \/\/ Disable right-click context menu\n    document.addEventListener(\"contextmenu\", function(e) {\n        e.preventDefault();\n    });\n\n    \/\/ Disable copy\n    document.addEventListener(\"copy\", function(e) {\n        e.preventDefault();\n    });\n\n    \/\/ Disable paste\n    document.addEventListener(\"paste\", function(e) {\n        e.preventDefault();\n    });\n\n    \/\/ Disable cut\n    document.addEventListener(\"cut\", function(e) {\n        e.preventDefault();\n    });\n\n    \/\/ Also disable drag selection\n    document.addEventListener(\"dragstart\", function(e) {\n        e.preventDefault();\n    });\n});","DefaultChoices":false,"DataExportTag":"Q13","QuestionType":"TE","Selector":"SL","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel","InputWidth":675,"InputHeight":29},"QuestionDescription":"870000 + 1500000","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"ContentType","MinChars":"1","TotalChars":"1","ContentType":"ValidNumber","ValidDateType":"DateWithFormat","ValidPhoneType":"ValidUSPhone","ValidZipType":"ValidUSZip","ValidNumber":{"Min":"","Max":"","NumDecimals":"0"}}},"GradingData":[{"Grades":{"SC_ehBDTCVctdnz22a":"1"},"TextEntry":"2370000"},{"Grades":{"SC_ehBDTCVctdnz22a":"1"},"TextEntry":"2370000 "},{"Grades":{"SC_ehBDTCVctdnz22a":"1"},"TextEntry":" 2370000 "}],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID106"}},{"SurveyID":"SV_8BojG59veOcpCOq","Element":"SQ","PrimaryAttribute":"QID108","SecondaryAttribute":"You will now be shown 16 numerical (addition) questions, one at a time. The task is to answer the...","TertiaryAttribute":null,"Payload":{"QuestionText":"You will now be shown 16 numerical (addition) questions, one at a time. The task is to answer the questions <strong>accurately<\/strong>, and as <strong>fast<\/strong> as you can. After typing in your answer, please click <strong>Submit<\/strong> as quickly as possible so that we can record your time.<br \/>\n<br \/>\nAfter <strong>30 seconds<\/strong>, if you have not submitted an answer, you will automatically proceed to the next question. A message will pop up when 15 seconds have passed, and when you only have 5 seconds left.<br \/>\n<br \/>\nYour compensation does not depend on whether you get the questions right or wrong, or on how fast you answer.<br \/>\n<br \/>\nThe task is to find the correct answer on your own, <strong>without the aid of any calculation tools (including writing it down, please stick to mental calculations).<\/strong><br \/>\n<br \/>\nAs soon as you proceed to the next page, your time for the first question will start.","DefaultChoices":false,"DataExportTag":"instructions_2","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"You will now be shown 16 numerical (addition) questions, one at a time. The task is to answer the...","Choices":[],"ChoiceOrder":[],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":1,"NextAnswerId":1,"QuestionID":"QID108"}},{"SurveyID":"SV_8BojG59veOcpCOq","Element":"SQ","PrimaryAttribute":"QID111","SecondaryAttribute":"Feedback Table Total Score: ${gr:\/\/SC_ehBDTCVctdnz22a\/Score} \/ 16 \u00a0 Question Correct Answer Your...","TertiaryAttribute":null,"Pa